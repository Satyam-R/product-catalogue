{
  "name": "product-catalogue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "start": "npm run build && concurrently --kill-others --success first -n app,inbox \"npm run server\" \"npm run inbox\"",
    "server": "tsx server/index.ts",
    "inbox": "node --experimental-require-module node_modules/maildev/dist/bin/maildev.js --ip 127.0.0.1 --web-ip 127.0.0.1 --max-emails 50",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/catalogue.test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "nodemailer": "10.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.2.5",
    "esbuild": "0.28.2",
    "maildev": "3.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "zod": "4.6.6"
  }
}
